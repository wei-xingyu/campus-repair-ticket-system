<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.weixingyu.campusrepairticketsystem.mapper.BuildingMapper">
    <select id="queryAllBuildings"
            resultType="com.weixingyu.campusrepairticketsystem.pojo.response.AdminBuildingResponse">
        SELECT id, name, address, enabled
        FROM building
        <where>
            <if test="enabled != null">
                enabled = #{enabled}
            </if>
        </where>
        ORDER BY id ASC
    </select>

</mapper>
